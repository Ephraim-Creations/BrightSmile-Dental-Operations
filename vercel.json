{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js?__url=/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__url=/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
